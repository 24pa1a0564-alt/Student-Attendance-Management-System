PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/attendance_db?retryWrites=true&w=majority
# For local MongoDB if installed:
# MONGODB_URI=mongodb://localhost:27017/student_attendance_db
JWT_SECRET=super_secret_jwt_key_replace_with_strong_random_string_in_production
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
FRONTEND_URL=http://localhost:5173

# Initial Administrator Credentials (used only during initial seed/setup)
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@attendance.edu
INITIAL_ADMIN_PASSWORD=Admin@123456
